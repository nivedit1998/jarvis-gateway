{
  "type": "object",
  "properties": {
    "v": {
      "const": 1
    },
    "origin": {
      "type": "string",
      "pattern": "^https://[a-z0-9][a-z0-9.-]*[a-z0-9]$"
    },
    "bridge_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "device_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "direction": {
      "enum": [
        "phone_to_bridge",
        "bridge_to_phone"
      ]
    },
    "lane": {
      "enum": [
        "command",
        "control",
        "event"
      ]
    },
    "message_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "key_epoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "seq": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,19}$"
    },
    "created_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "expires_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "enc": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "minLength": 87,
      "maxLength": 87
    },
    "ct": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "minLength": 22,
      "maxLength": 65536
    }
  },
  "required": [
    "v",
    "origin",
    "bridge_id",
    "device_id",
    "direction",
    "lane",
    "message_id",
    "key_epoch",
    "seq",
    "created_at",
    "expires_at",
    "enc",
    "ct"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jarvis:e2e:v1:envelope",
  "title": "Agreed v1 cryptographic envelope; runtime validation is also mandatory",
  "allOf": [
    {
      "if": {
        "properties": {
          "direction": {
            "const": "bridge_to_phone"
          }
        }
      },
      "then": {
        "properties": {
          "lane": {
            "const": "event"
          }
        }
      },
      "else": {
        "properties": {
          "lane": {
            "enum": [
              "command",
              "control"
            ]
          }
        }
      }
    }
  ]
}
