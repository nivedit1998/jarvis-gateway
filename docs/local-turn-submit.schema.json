{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jarvis:local-turn-submit:0.1-draft",
  "title": "Draft LOCAL Core turn submission \u2014 not the E2E wire contract",
  "type": "object",
  "required": [
    "session",
    "turn_id",
    "request_id",
    "revision",
    "segments"
  ],
  "properties": {
    "session": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "turn_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 256
    },
    "namespace": {
      "enum": [
        "dinodia",
        "personal",
        "system"
      ]
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": [
          "text",
          "revision"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "interrupted_jarvis": {
            "type": "boolean"
          }
        },
        "additionalProperties": true
      }
    },
    "interruptions": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": [
          "request_id",
          "spoken_text"
        ],
        "properties": {
          "request_id": {
            "type": "string"
          },
          "spoken_text": {
            "type": "string"
          },
          "was_speaking": {
            "type": "boolean"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true,
  "description": "Runtime additionally validates total text length, ordered revisions, predecessor lineage, idempotency digest and spoken prefixes."
}
